# Copy to .env.local and fill in. .env.local is gitignored.

# ── LLM assistant (the `ai` terminal command + AI Assistant app) ──
# Any OpenAI-compatible endpoint. Defaults target Groq's free tier.
# Without LLM_API_KEY the assistant stays gracefully offline.
LLM_API_KEY=
# Optional overrides. Models are tried in order; a rate-limited or retired
# model hands over to the next (Groq meters each model separately).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# ── Semantic Scholar (Research app → Connections panel), optional ──
# Anonymous requests share one global pool and are often rate-limited (429);
# the panel then links out instead. A free key lifts that (1 request/second).
# Server-only: never prefix it with NEXT_PUBLIC_.
S2_API_KEY=

# ── Work with me → email (the brief form on the Hire app and /hire) ──
# With these two set, a brief is sent to my inbox over SMTP with the visitor
# as Reply-To. Without them the form falls back to the visitor's own mail app.
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste the 16 characters here.
# Server-only: never prefix these with NEXT_PUBLIC_.
SMTP_USER=
SMTP_PASS=
# Optional overrides. Defaults: Gmail over implicit TLS, delivered to the
# address in src/data/resume.ts, sent from SMTP_USER.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# HIRE_TO=
# HIRE_FROM=
