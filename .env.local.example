# Copy to .env.local and fill in. .env.local is gitignored.

# ── Supabase (powers the multiplayer games + live chat + whiteboard) ──
# Browser-side Realtime uses the publishable/anon key. Without these,
# multiplayer features gracefully fall back to local-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── LLM assistant (the `ai` terminal command + AI Assistant app) ──
# Any OpenAI-compatible endpoint. Defaults target Groq (fast free tier).
# Without LLM_API_KEY the assistant stays gracefully offline.
LLM_API_KEY=
# Optional overrides:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
