# Copy to .env. Every setting is optional; the defaults run the simulated backend.

# sim  no model: real engine, simulated text
# api  Tier A: any OpenAI-compatible endpoint
# local  Tier B: an open-weights model on this machine, with activation steering
STEER_BACKEND=sim

# ── Tier A ──
# STEER_API_BASE_URL=https://api.groq.com/openai/v1
# STEER_API_KEY=
# STEER_API_MODEL=openai/gpt-oss-20b
# chat = /chat/completions; completion = /completions, for a raw continuation model
# STEER_API_MODE=chat
# STEER_API_TEMPERATURE=0.8
# A JSON object merged into every request, for provider switches, e.g. hiding a reasoning model's thinking:
# STEER_API_EXTRA={"reasoning_effort":"low","include_reasoning":false}

# ── the focus monitor ──
# auto: the model's own attention in Tier B; in Tier A the proxy model if it can load, else the heuristic
# STEER_ATTENTION=auto
# STEER_PROXY_MODEL=Qwen/Qwen2.5-0.5B

# ── Tier B ──
# STEER_LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# STEER_LOCAL_DEVICE=auto
# STEER_LOCAL_DTYPE=auto
# STEER_VECTORS_DIR=vectors
# how hard a full-weight pin pulls attention, in logits
# STEER_PIN_BIAS=2.0

# ── the engine ──
# tokens written past the anchor before the engine idles
# STEER_HORIZON=120
# speculation: pre-generate the dial's neighbours while idle, this deep
# STEER_SPECULATE=true
# STEER_SPEC_TOKENS=48
# STEER_DEBOUNCE_MS=30
# STEER_DEBOUNCE_MAX_MS=90
# how long a request still waiting for its first token is left to land when the controls move on
# STEER_HOLD_MS=400
# STEER_CACHE_SIZE=64
# the longest a text may grow, in display tokens
# STEER_MAX_TOKENS=4000

# ── the server ──
# STEER_HOST=127.0.0.1
# STEER_PORT=8017
# Origins allowed to open the WebSocket, comma-separated. Empty allows any: set this before exposing the port.
# STEER_ALLOWED_ORIGINS=http://localhost:3017
# Raise instead of logging when a request outlives its cancel
# STEER_STRICT=1
